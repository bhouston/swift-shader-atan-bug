{
  "name": "swift-shader-atan-bug",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project swiftshader --project webgpu-swiftshader --project webgpu",
    "test:webgl": "vitest run --project swiftshader",
    "test:webgpu": "vitest run --project webgpu-swiftshader --project webgpu",
    "test:controls": "vitest run --project swiftshader --project webgpu-swiftshader --project webgpu -t control",
    "test:hardware": "vitest run --project hardware --project webgpu"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "vitest": "5.0.3"
  }
}
